# Copy this file to .env and fill in your own credentials.
# Never commit the real .env file.
DUALIS_USER=s123456
DUALIS_PASSWD=replace-with-your-dualis-password
SEMESTER_ID=
DISCORD_WEBHOOK=https://discord.com/api/webhooks/123456789/replace-with-your-webhook-token
# Optional: defaults to "Dualis Notifier"
AGENT_NAME=Dualis Notifier
# Relative paths are resolved against the project directory, not the current directory.
DATA_DIR=data
CONNECT_TIMEOUT=5
READ_TIMEOUT=30
# Used by --watch / Docker; seconds between completed checks.
CHECK_INTERVAL=900
